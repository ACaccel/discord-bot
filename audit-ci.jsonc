// audit-ci configuration — fails CI on HIGH or CRITICAL advisories from
// `yarn audit`, with a path-scoped allowlist for advisories we have
// explicitly decided to accept (with rationale tracked here).
//
// Allowlist policy:
//   - Every entry uses the `GHSA-...|path>chain` form so a same-GHSA
//     reaching us via a different path is NOT silently allowed.
//   - Every entry has a header comment naming the offending dep tree,
//     the reason it is acceptable, and a remediation plan.
//   - Re-evaluate quarterly. When the upstream chain ships a fix, drop
//     the entry and let the gate re-enforce.
//   - Do NOT use this file to silence advisories we could fix with a
//     direct dep upgrade — fix those at source.
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "critical": true,
  "moderate": false,
  "low": false,
  "report-type": "full",
  "package-manager": "yarn",
  "allowlist": [
    // -------------------------------------------------------------------
    // @kirdock/discordjs-voice-recorder tree (9 entries below).
    //
    // The package is used by the /record command (nijika, tomori) and
    // has not seen maintenance updates that would address its
    // transitives. Risk surface:
    //   - opus decoding only runs on incoming voice frames inside a
    //     voice channel the bot was invited to; not remotely reachable
    //     from arbitrary users.
    //   - tar is invoked at install time by @discordjs/node-pre-gyp to
    //     fetch the prebuilt opus binary. The fetched URL is pinned in
    //     the lockfile (deterministic), not user-controlled. The
    //     path-traversal advisories require attacker-supplied tar
    //     archives, which is not our use case.
    //
    // Remediation plan: post-overhaul, evaluate replacing
    // @kirdock/discordjs-voice-recorder with a maintained alternative
    // (discord-voip, or @discordjs/voice + a current opus binding).
    // Owner: ACaccel. Tracked separately from the architecture overhaul.
    // -------------------------------------------------------------------

    // opus DoS (no upstream patch).
    "GHSA-43wq-xrcm-3vgr|@kirdock/discordjs-voice-recorder>@discordjs/opus",

    // tar advisories (path traversal / symlink / hardlink / race /
    // decompression DoS). @discordjs/node-pre-gyp pins `tar@^6.1.11`, and
    // upstream ships fixes only on the 7.x line (7.5.21+) — there is no
    // 6.x backport, so no in-range remediation exists short of replacing
    // the recorder. A `resolutions` jump to tar 7 would break node-pre-gyp
    // (ESM-only, changed API) and so is not an option here.
    "GHSA-34x7-hfp2-rc4v|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",
    "GHSA-8qq5-rm4j-mr97|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",
    "GHSA-83g3-92jg-28cx|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",
    "GHSA-qffp-2rhf-9h96|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",
    "GHSA-9ppj-qmqm-q256|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",
    "GHSA-r6q2-hw4h-h46w|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",
    "GHSA-23hp-3jrh-7fpw|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",
    "GHSA-8x88-c5mf-7j5w|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",
    "GHSA-r292-9mhp-454m|@kirdock/discordjs-voice-recorder>@discordjs/opus>@discordjs/node-pre-gyp>tar",

    // -------------------------------------------------------------------
    // discord.js > @discordjs/builders > @sapphire/shapeshift > lodash
    //
    // GHSA-r5fr-rjxr-66jc — lodash code injection via `_.template`. The
    // advisory's "patched in >=4.18.0" cites a version that does NOT
    // exist on the public registry (lodash latest is 4.17.21 and
    // upstream is in maintenance-only mode). discord.js v14 carries
    // this chain via @sapphire/shapeshift's argument-validation
    // helpers; the affected `_.template` API is not called by any
    // code we control.
    //
    // Remediation plan: track discord.js v15 / @sapphire/shapeshift v5
    // for a dependency swap; revisit at every discord.js minor bump.
    // -------------------------------------------------------------------
    "GHSA-r5fr-rjxr-66jc|discord.js>@discordjs/builders>@sapphire/shapeshift>lodash",
    "GHSA-r5fr-rjxr-66jc|@discordjs/builders>@sapphire/shapeshift>lodash",
  ],
}
