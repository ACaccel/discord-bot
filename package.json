{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install-lock": "yarn install --frozen-lockfile",
    "deploy": "ts-node src/deploy.ts",
    "tomori": "ts-node src/bot/tomori/index.ts",
    "nijika": "ts-node src/bot/nijika/index.ts",
    "msg_archive": "ts-node src/bot/msg_archive/index.ts",
    "konata": "ts-node src/bot/konata/index.ts",
    "typecheck": "tsc -p tsconfig.strict.json",
    "typecheck:legacy": "tsc --noEmit",
    "lint": "eslint src/core src/persistence src/infra src/db src/utils/logger.ts scripts test eslint.config.mjs vitest.config.ts",
    "lint:legacy": "eslint .",
    "lint:fix": "eslint src/core src/persistence src/infra src/db src/utils/logger.ts scripts test --fix",
    "format": "prettier --write src/core src/persistence src/infra src/db src/utils/logger.ts scripts test eslint.config.mjs vitest.config.ts tsconfig.strict.json *.md",
    "format:check": "prettier --check src/core src/persistence src/infra src/db src/utils/logger.ts scripts test eslint.config.mjs vitest.config.ts tsconfig.strict.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:i18n": "vitest run --project i18n",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "handlers:gen": "ts-node scripts/gen-registry.ts",
    "handlers:gen:check": "ts-node scripts/gen-registry.ts --check",
    "security": "audit-ci --config audit-ci.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACaccel/discord-bot.git"
  },
  "author": "ACaccel, rbt4168",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ACaccel/discord-bot/issues"
  },
  "homepage": "https://github.com/ACaccel/discord-bot#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@google/generative-ai": "^0.24.1",
    "@kirdock/discordjs-voice-recorder": "^1.1.1",
    "@types/express": "^5.0.0",
    "@types/node-schedule": "^2.1.7",
    "axios": "^1.15.2",
    "canvas": "^3.2.0",
    "discord.js": "^14.21.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "i18next": "^23.15.1",
    "mee6-levels-api": "^1.3.1",
    "mongoose": "^8.22.1",
    "node-schedule": "^2.1.1",
    "openai": "^6.36.0",
    "pino": "^10.3.1",
    "sodium": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.3",
    "audit-ci": "^7.1.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.11.0",
    "knip": "^5.34.0",
    "mongodb-memory-server": "^11.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  }
}
