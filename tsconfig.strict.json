{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // Strict-mode scope. Each layer joins as it is migrated; PR-G will
  // extend this to `src/handlers/**`, `src/bot/**`, and `src/utils/**`.
  // `src/db/**` retired in PR-E (audit C-2): schemas live in
  // `src/persistence/schemas/**` and the legacy shim was deleted.
  "include": [
    "src/core/**/*",
    "src/persistence/**/*",
    "src/infra/mongo/**/*",
    "src/infra/llm/**/*",
    "src/utils/logger.ts",
    "scripts/**/*",
    "test/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
