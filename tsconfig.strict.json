{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // Phase 0: strict typechecking applies only to newly-added code paths.
  // Each later phase that converts a legacy directory adds its path here.
  // Phase 1: `src/db/**` — schemas now have typed doc interfaces and the
  //   connection factory returns a strongly-typed `Models` map.
  // Phase 2: `src/persistence/**` (schemas + repositories now live here;
  //   src/db/** is a thin re-export shim) and `src/infra/mongo/**`
  //   (ConnectionManager owns the SDK lifecycle).
  "include": [
    "src/core/**/*",
    "src/db/**/*",
    "src/persistence/**/*",
    "src/infra/mongo/**/*",
    "scripts/**/*",
    "test/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
